{
  "schema_version": 1,
  "id": "two-tool-order",
  "suite": "smoke",
  "prompt": "Read a.txt, then write b.txt.",
  "plan": {
    "needs_plan": false,
    "steps": []
  },
  "script": [
    {
      "type": "tool_call",
      "name": "read_file",
      "arguments": {
        "path": "a.txt"
      },
      "id": "call_read"
    },
    {
      "type": "tool_call",
      "name": "write_file",
      "arguments": {
        "path": "b.txt",
        "content": "hello"
      },
      "id": "call_write"
    },
    {
      "type": "final",
      "content": "Final Answer: written"
    }
  ],
  "tools": {
    "read_file": {
      "result": "hello",
      "parallel_safe": true
    },
    "write_file": {
      "result": "wrote b.txt",
      "parallel_safe": false
    }
  },
  "limits": {
    "max_rounds": 4
  },
  "expect": {
    "history_valid": true,
    "tool_sequence": [
      "read_file",
      "write_file"
    ],
    "tool_args": [
      {
        "path": "a.txt"
      },
      {
        "path": "b.txt"
      }
    ],
    "final_contains": [
      "written"
    ],
    "max_rounds": 3,
    "max_model_requests": 4,
    "no_tool_errors": true
  }
}
